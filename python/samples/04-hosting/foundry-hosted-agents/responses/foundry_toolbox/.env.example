# Copy to .env for standalone Python or VS Code runs after deploying dependencies.
FOUNDRY_PROJECT_ENDPOINT="https://<account>.services.ai.azure.com/api/projects/<project>"
AZURE_AI_MODEL_DEPLOYMENT_NAME="<model-deployment-name>"
# From: azd env get-value TOOLBOX_AGENT_TOOLS_MCP_ENDPOINT
TOOLBOX_ENDPOINT="https://<account>.services.ai.azure.com/api/projects/<project>/toolboxes/agent-tools/versions/<version>/mcp?api-version=v1"