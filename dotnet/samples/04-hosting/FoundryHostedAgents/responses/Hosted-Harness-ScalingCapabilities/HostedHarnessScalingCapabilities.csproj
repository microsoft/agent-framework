<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);MAAI001;OPENAI001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.AI.Projects" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="DotNetEnv" />
    <PackageReference Include="Hyperlight.HyperlightSandbox.Guest.Python" />
  </ItemGroup>

  <!-- The linked console script runner imports logging itself; do not also generate a Web SDK global import. -->
  <ItemGroup>
    <Using Remove="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\..\src\Microsoft.Agents.AI.Foundry\Microsoft.Agents.AI.Foundry.csproj" />
    <ProjectReference Include="..\..\..\..\..\src\Microsoft.Agents.AI.Foundry.Hosting\Microsoft.Agents.AI.Foundry.Hosting.csproj" />
    <ProjectReference Include="..\..\..\..\..\src\Microsoft.Agents.AI.Harness\Microsoft.Agents.AI.Harness.csproj" />
    <ProjectReference Include="..\..\..\..\..\src\Microsoft.Agents.AI.Hyperlight\Microsoft.Agents.AI.Hyperlight.csproj" />
    <ProjectReference Include="..\..\..\..\..\src\Microsoft.Agents.AI.Mcp\Microsoft.Agents.AI.Mcp.csproj" />
    <ProjectReference Include="..\..\..\..\..\src\Microsoft.Agents.AI.Tools.Shell\Microsoft.Agents.AI.Tools.Shell.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Hosted-Harness-Research\StatelessWebSearchChatClient.cs"
             Link="StatelessWebSearchChatClient.cs" />
    <Compile Include="..\..\..\..\02-agents\Harness\BuildYourOwnClaw\Claw_Step03_ScalingCapabilities\*.cs"
             Exclude="..\..\..\..\02-agents\Harness\BuildYourOwnClaw\Claw_Step03_ScalingCapabilities\Program.cs"
             Link="%(Filename)%(Extension)" />
    <Content Include="..\..\..\..\02-agents\Harness\BuildYourOwnClaw\Claw_Step03_ScalingCapabilities\skills\**\*"
             Link="skills\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\..\02-agents\Harness\BuildYourOwnClaw\Claw_Step03_ScalingCapabilities\working\**\*"
             Link="working\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
