<Project>

  <PropertyGroup>
    <ImportDirectoryPackagesProps>false</ImportDirectoryPackagesProps>
  </PropertyGroup>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk.Web" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks></TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HostedWorkflowHandoff</RootNamespace>
    <AssemblyName>HostedWorkflowHandoff</AssemblyName>
    <UserSecretsId>92fa9432-1e9c-4f74-a2c2-7423f2042504</UserSecretsId>
    <NoWarn>$(NoWarn);MAAIW001;OPENAI001</NoWarn>
    <AgentFrameworkVersion>1.27.0-preview.261030.1</AgentFrameworkVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI.Foundry" Version="$(AgentFrameworkVersion)" />
    <PackageReference Include="Microsoft.Agents.AI.Foundry.Hosting" Version="$(AgentFrameworkVersion)" />
    <PackageReference Include="Microsoft.Agents.AI.Hosting" Version="$(AgentFrameworkVersion)" />
    <!-- Published Agent Framework 1.27 resolves MEAI OpenAI 10.10.1, which returns 401 for
         hosted project-model calls. Remove this pin when the next framework release carries 10.11+. -->
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.11.0" />
    <PackageReference Include="DotNetEnv" Version="3.2.0" />
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk.Web" />

</Project>
