<Project>

  <PropertyGroup>
    <ImportDirectoryPackagesProps>false</ImportDirectoryPackagesProps>
  </PropertyGroup>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk.Web" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks></TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);MAAI001;OPENAI001</NoWarn>
    <AgentFrameworkVersion>1.20.0-preview.260831.1</AgentFrameworkVersion>
    <!-- Repository builds use local source; the prepared ZIP restores standalone packages. -->
    <UseLocalFramework Condition="'$(UseLocalFramework)' == '' and Exists('..\..\..\..\..\src\Microsoft.Agents.AI.Harness\Microsoft.Agents.AI.Harness.csproj')">true</UseLocalFramework>
    <UseLocalFramework Condition="'$(UseLocalFramework)' == ''">false</UseLocalFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DotNetEnv" Version="3.2.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalFramework)' != 'true'">
    <PackageReference Include="Microsoft.Agents.AI.Foundry" Version="$(AgentFrameworkVersion)" />
    <PackageReference Include="Microsoft.Agents.AI.Foundry.Hosting" Version="$(AgentFrameworkVersion)" />
    <PackageReference Include="Microsoft.Agents.AI.Harness" Version="$(AgentFrameworkVersion)" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalFramework)' == 'true'">
    <ProjectReference Include="..\..\..\..\..\src\Microsoft.Agents.AI.Foundry\Microsoft.Agents.AI.Foundry.csproj" />
    <ProjectReference Include="..\..\..\..\..\src\Microsoft.Agents.AI.Foundry.Hosting\Microsoft.Agents.AI.Foundry.Hosting.csproj" />
    <ProjectReference Include="..\..\..\..\..\src\Microsoft.Agents.AI.Harness\Microsoft.Agents.AI.Harness.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalFramework)' == 'true'">
    <Content Include="..\..\..\..\02-agents\Harness\Harness_Step03_DataProcessing\working\sales.csv"
             Link="working\sales.csv" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalFramework)' != 'true'">
    <Content Include="working\sales.csv" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk.Web" />
  <Import Project="..\..\scripts\SourceDeployment.targets" Condition="Exists('..\..\scripts\SourceDeployment.targets')" />

</Project>
