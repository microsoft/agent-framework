<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- ResponsibleAI.AgentHooks targets net8.0, so this package cannot target netstandard2.0/net472. -->
    <TargetFrameworks>$(TargetFrameworksCore)</TargetFrameworks>
    <!-- The AGENT-HOOKS wire projection serializes arbitrary tool arguments/results via
         reflection-based System.Text.Json, which is incompatible with trimming/AOT. -->
    <IsAotCompatible>false</IsAotCompatible>
    <!-- This package's whole surface is experimental (MAAI001) and consumes experimental framework APIs. -->
    <NoWarn>$(NoWarn);MEAI001;MAAI001</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <InjectSharedThrow>true</InjectSharedThrow>
    <InjectSharedDiagnosticIds>true</InjectSharedDiagnosticIds>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Microsoft.Agents.AI\Microsoft.Agents.AI.csproj" />
    <ProjectReference Include="..\Microsoft.Agents.AI.Abstractions\Microsoft.Agents.AI.Abstractions.csproj" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="ResponsibleAI.AgentHooks" />
  </ItemGroup>

  <PropertyGroup>
    <!-- NuGet Package Settings -->
    <Title>Microsoft.Agents.AI.AgentHooks</Title>
    <Description>AGENT-HOOKS-0.1 interception-contract enforcement for Microsoft Agent Framework agents.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Microsoft.Agents.AI.AgentHooks.UnitTests" />
  </ItemGroup>

</Project>
