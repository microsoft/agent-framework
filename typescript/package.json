{
  "name": "agent-framework-typescript",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @microsoft/agent-framework-core && npm run build --workspace @microsoft/agent-framework-openai",
    "test": "npm run test --workspaces --if-present",
    "typecheck:test": "npm run typecheck:test --workspaces --if-present",
    "typecheck:samples": "tsc -p tsconfig.samples.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run build && npm run typecheck:test && npm test && npm run typecheck:samples",
    "sample": "tsx samples/getting-started.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  }
}
